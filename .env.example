# Copier ce fichier en .env et remplir les vraies valeurs — ne jamais committer .env
SECRET_KEY=change-me-to-a-long-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
DATABASE_URL=sqlite:///./secureapi.db
# Laisser vide pour du rate limiting en mémoire (dev local).
# En production : redis://localhost:6379
RATE_LIMIT_STORAGE_URI=
ALLOWED_ORIGINS=http://localhost:3000
